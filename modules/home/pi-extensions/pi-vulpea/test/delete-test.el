;;; delete-test.el --- Resource deletion regressions -*- lexical-binding: t; -*-
(load (expand-file-name "conflicts-test.el" (file-name-directory load-file-name)) nil t)

(ert-deftest pi-vulpea-delete-trashes-resource-and-prunes-all-ids ()
  (pi-vulpea-test-vault
   (let* ((resource (pi-vulpea-test-call "create" :kind "resource" :title "Disposable reference"))
          (id (pi-vulpea-test-id resource))
          (child (pi-vulpea-test-call "create" :kind "heading" :title "Nested finding"
                                     :parentId id :revision (pi-vulpea-test-revision id)))
          (child-id (pi-vulpea-test-id child))
          (path (pi-vulpea--path (vulpea-note-path (pi-vulpea--note id))))
          (buffer (pi-vulpea--buffer path))
          (trash (expand-file-name "trashed-resource.org" temp)))
     ;; Model trash locally: never touch the real OS trash in the test suite.
     (cl-letf (((symbol-function 'move-file-to-trash)
                (lambda (file) (rename-file file trash))))
       (let ((result (pi-vulpea-test-call "delete" :id id :revision (pi-vulpea-test-revision id))))
         (should (alist-get 'deleted result))
         (should (equal "trash" (alist-get 'destination result)))))
     (should-not (file-exists-p path))
     (should (file-exists-p trash))
     (should-not (buffer-live-p buffer))
     (dolist (deleted-id (list id child-id))
       (should-not (vulpea-db-get-by-id deleted-id))
       (should-not (gethash deleted-id org-id-locations)))
     (should (vulpea-db-get-by-id area-id))
     ;; Restoring unchanged content must be re-indexable, not blocked by an old hash row.
     (rename-file trash path)
     (vulpea-db-update-file path)
     (should (vulpea-db-get-by-id id))
     (should (vulpea-db-get-by-id child-id)))))

(ert-deftest pi-vulpea-delete-protects-areas-people-headings-and-conflicts ()
  (pi-vulpea-test-vault
   (let* ((person (pi-vulpea-test-call "create" :kind "person" :title "Jane Doe"))
          (resource (pi-vulpea-test-call "create" :kind "resource" :title "Keep this"))
          (id (pi-vulpea-test-id resource))
          (child (pi-vulpea-test-call "create" :kind "heading" :title "Keep child"
                                     :parentId id :revision (pi-vulpea-test-revision id)))
          (path (vulpea-note-path (pi-vulpea--note id)))
          (buffer (pi-vulpea--buffer path)))
     (cl-letf (((symbol-function 'move-file-to-trash) (lambda (&rest _) (ert-fail "Must not trash a refused target"))))
       (dolist (protected-id (list area-id (pi-vulpea-test-id person) (pi-vulpea-test-id child)))
         (should-error (pi-vulpea-test-call "delete" :id protected-id :revision (pi-vulpea-test-revision protected-id))))
       (should-error (pi-vulpea-test-call "delete" :id id :revision (make-string 64 ?0)))
       (let ((revision (pi-vulpea-test-revision id)))
         (with-current-buffer buffer (goto-char (point-max)) (insert "Unsaved edit"))
         (should-error (pi-vulpea-test-call "delete" :id id :revision revision))
         (with-current-buffer buffer (set-buffer-modified-p nil)))
       (with-current-buffer buffer
         (let ((buffer-read-only t))
           (should-error (pi-vulpea-test-call "delete" :id id :revision (pi-vulpea-test-revision id)))))
       (let ((revision (pi-vulpea-test-revision id)))
         (set-file-times path (time-add (current-time) 10))
         (should-error (pi-vulpea-test-call "delete" :id id :revision revision))))
     (should (file-exists-p path))
     (should (vulpea-db-get-by-id id)))))

(ert-deftest pi-vulpea-delete-protects-live-classification-before-index-catches-up ()
  (pi-vulpea-test-vault
   (let* ((resource (pi-vulpea-test-call "create" :kind "resource" :title "Now an area"))
          (id (pi-vulpea-test-id resource))
          (path (vulpea-note-path (pi-vulpea--note id))))
     (with-current-buffer (pi-vulpea--buffer path)
       (goto-char (point-min))
       (vulpea-buffer-tags-set "area")
       (let ((after-save-hook nil)) (save-buffer)))
     (should-not (member "area" (vulpea-note-tags (pi-vulpea--note id))))
     (cl-letf (((symbol-function 'move-file-to-trash) (lambda (&rest _) (ert-fail "Must not trash a newly tagged area"))))
       (should-error (pi-vulpea-test-call "delete" :id id :revision (pi-vulpea-test-revision id))))
     (should (file-exists-p path)))))

(ert-deftest pi-vulpea-delete-trash-failure-never-falls-back-to-permanent-delete ()
  (pi-vulpea-test-vault
   (let* ((resource (pi-vulpea-test-call "create" :kind "resource" :title "Trash unavailable"))
          (id (pi-vulpea-test-id resource))
          (path (vulpea-note-path (pi-vulpea--note id))))
     (cl-letf (((symbol-function 'move-file-to-trash) (lambda (&rest _) (error "Trash unavailable"))))
       (should-error (pi-vulpea-test-call "delete" :id id :revision (pi-vulpea-test-revision id))))
     (should (file-exists-p path))
     (should (vulpea-db-get-by-id id)))))
