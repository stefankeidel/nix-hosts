;;; bridge-test.el --- Isolated bridge tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'vulpea)
(require 'vulpea-para)
(load (expand-file-name "../bridge.el" (file-name-directory load-file-name)) nil t)

(defun pi-vulpea-test-call (operation &rest args)
  (let ((request (list (cons "operation" operation))))
    (while args
      (push (cons (substring (symbol-name (pop args)) 1) (pop args)) request))
    (pi-vulpea-dispatch request)))

(defun pi-vulpea-test-id (response)
  (alist-get 'id (alist-get 'note response)))

(defun pi-vulpea-test-revision (id)
  (alist-get 'revision (pi-vulpea-test-call "read" :id id)))

(defmacro pi-vulpea-test-vault (&rest body)
  `(let* ((temp (make-temp-file "pi-vulpea-test-" t))
          (org-directory (expand-file-name "vault/" temp))
          (vulpea-db-location (expand-file-name "notes.db" temp))
          (vulpea-db-sync-directories (list org-directory))
          (org-id-locations-file (expand-file-name "ids" temp))
          (org-id-locations nil)
          (org-id-files nil)
          (org-todo-keywords '((sequence "TODO" "|" "DONE" "CANCELLED")))
          (vulpea-db-autosync-mode nil)
          (area-id "11111111-1111-1111-1111-111111111111"))
     (unwind-protect
         (progn
           (make-directory org-directory t)
           (with-temp-file (expand-file-name "area.org" org-directory)
             (insert ":PROPERTIES:\n:ID: " area-id "\n:END:\n#+title: Central Data\n#+filetags: :area:\n\n* Notes\n* Tasks\n* Archive :ARCHIVE:\n"))
           (vulpea-db-update-file (expand-file-name "area.org" org-directory))
           (vulpea-para-agenda-mode +1)
           ,@body)
       (vulpea-para-agenda-mode -1)
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer)
                    (file-in-directory-p (buffer-file-name buffer) temp))
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (vulpea-db-close)
       (delete-directory temp t))))

(ert-deftest pi-vulpea-resources-literal-body-and-edits ()
  (pi-vulpea-test-vault
   (let* ((literal "OAuth facts. %(error \"must not execute\") ${title}\n")
          (created (pi-vulpea-test-call "create" :kind "resource" :title "OAuth troubleshooting" :body literal))
          (id (pi-vulpea-test-id created)))
     (should (string-match-p (regexp-quote literal) (alist-get 'content created)))
     (should (member "resource" (append (alist-get 'buckets (alist-get 'note created)) nil)))
     (should-error (pi-vulpea-test-call "create" :kind "resource" :title "OAuth troubleshooting"))
     (let ((revision (pi-vulpea-test-revision id)))
       (pi-vulpea-test-call "update" :id id :revision revision :action "append" :text "Check admin consent.")
       (should-error (pi-vulpea-test-call "update" :id id :revision revision :action "append" :text "stale")))
     (pi-vulpea-test-call "update" :id id :revision (pi-vulpea-test-revision id)
                          :action "replace" :oldText "Check admin consent." :text "Verify delegated consent.")
     (should (string-match-p "Verify delegated consent" (alist-get 'content (pi-vulpea-test-call "read" :id id))))
     (should-error (pi-vulpea-test-call "update" :id id :revision (pi-vulpea-test-revision id)
					:action "replace" :oldText "OAuth troubleshooting" :text "Do not rename headers"))
     (should (= 1 (length (alist-get 'items (pi-vulpea-test-call "list" :kind "resource" :query "OAuth")))))
     (should (alist-get 'nextOffset (pi-vulpea-test-call "read" :id id :limit 10)))
     (let* ((note (pi-vulpea--note id))
            (buffer (get-file-buffer (vulpea-note-path note))))
       (with-current-buffer buffer (goto-char (point-max)) (insert "unsaved"))
       (should (eq t (alist-get 'unsaved (pi-vulpea-test-call "read" :id id))))
       (should-error (pi-vulpea-test-call "update" :id id :revision (pi-vulpea-test-revision id)
                                          :action "append" :text "must refuse"))))))

(ert-deftest pi-vulpea-project-lifecycle-and-archive-search ()
  (pi-vulpea-test-vault
   (let* ((project (pi-vulpea-test-call "create" :kind "project" :title "Enable MCP sign-in"
                                        :parentId area-id :revision (pi-vulpea-test-revision area-id)
                                        :body "Outcome: delegated sign-in works."))
          (id (pi-vulpea-test-id project))
          (task (pi-vulpea-test-call "create" :kind "task" :title "Verify scope"
                                     :parentId id :revision (pi-vulpea-test-revision id)))
          (task-id (pi-vulpea-test-id task)))
     (should (string-match-p "Central Data > Enable MCP sign-in" (alist-get 'content project)))
     (should (= 1 (length (alist-get 'items (pi-vulpea-test-call "list" :kind "project")))))
     (should-error (pi-vulpea-test-call "update" :id id :revision (pi-vulpea-test-revision id) :action "archive"))
     (pi-vulpea-test-call "update" :id task-id :revision (pi-vulpea-test-revision task-id) :action "todo" :text "DONE")
     (pi-vulpea-test-call "update" :id id :revision (pi-vulpea-test-revision id) :action "todo" :text "DONE")
     (pi-vulpea-test-call "update" :id id :revision (pi-vulpea-test-revision id) :action "archive")
     (should-not (vulpea-db-get-by-id id))
     (should-not (vulpea-db-get-by-id task-id))
     (should (= 1 (length (alist-get 'items (pi-vulpea-test-call "search" :query "Outcome: delegated sign-in works.")))))
     (should (string-match-p "Archive.*:ARCHIVE:" (alist-get 'content (pi-vulpea-test-call "read" :id area-id)))))))

(ert-deftest pi-vulpea-people-meetings-and-area-reference ()
  (pi-vulpea-test-vault
   (let* ((person (pi-vulpea-test-call "create" :kind "person" :title "Jane Doe" :body "Platform contact."))
          (person-id (pi-vulpea-test-id person))
          (meeting (pi-vulpea-test-call "create" :kind "meeting" :title "2026-11-16 OAuth discussion"
                                        :parentId person-id :revision (pi-vulpea-test-revision person-id)
                                        :body "Decided to check delegated scopes."))
          (task (pi-vulpea-test-call "create" :kind "task" :title "Ask Jane about scopes"
                                     :parentId area-id :revision (pi-vulpea-test-revision area-id)
                                     :peopleIds (list person-id))))
     (should (member "people" (vulpea-note-tags (pi-vulpea--note person-id))))
     (should-not (vulpea-para-area-p (pi-vulpea--note person-id)))
     (should (string-match-p ":MEETING:" (alist-get 'content meeting)))
     (should (string-match-p "Meetings" (alist-get 'content (pi-vulpea-test-call "read" :id person-id))))
     (should (member "@JaneDoe" (vulpea-note-tags (pi-vulpea--note (pi-vulpea-test-id task)))))
     (let* ((notes-id (with-current-buffer (pi-vulpea--buffer (expand-file-name "area.org" org-directory))
                        (goto-char (point-min)) (re-search-forward "^\\* Notes$")
                        (org-id-get-create)))
            (path (file-truename (expand-file-name "area.org" org-directory))))
       (with-current-buffer (get-file-buffer path) (pi-vulpea--save))
       (let ((heading (pi-vulpea-test-call "create" :kind "heading" :title "dbt triage"
                                           :parentId notes-id :revision (pi-vulpea-test-revision notes-id)
                                           :body "Reproduction commands.")))
         (should (= 2 (vulpea-note-level (pi-vulpea--note (pi-vulpea-test-id heading)))))
         (should-not (vulpea-para-resource-p (pi-vulpea--note (pi-vulpea-test-id heading)))))))))

(ert-deftest pi-vulpea-safety-and-envelope ()
  (pi-vulpea-test-vault
   (should-error (pi-vulpea--path (expand-file-name "../outside.org" org-directory)))
   (should-error (pi-vulpea-test-call "create" :kind "area" :title "Not implicit"))
   (should-error (pi-vulpea-test-call "create" :kind "resource" :title "Bad\n#+filetags: :area:"))
   (should-error (pi-vulpea-test-call "update" :id area-id :revision (pi-vulpea-test-revision area-id)
                                      :action "tags" :removeTags '("area")))
   (should-error (pi-vulpea-test-call "create" :kind "project" :title "Malformed body"
                                      :parentId area-id :revision (pi-vulpea-test-revision area-id)
                                      :body "* Escapes the project"))
   (should-not (buffer-modified-p (get-file-buffer (file-truename (expand-file-name "area.org" org-directory)))))
   (let* ((request (base64-encode-string (encode-coding-string "{\"operation\":\"status\"}" 'utf-8) t))
          (response (json-read-from-string (decode-coding-string (base64-decode-string (pi-vulpea-dispatch-json request)) 'utf-8))))
     (should (alist-get 'ok response)))
   (let* ((json-false :json-false)
          (response (json-read-from-string (base64-decode-string (pi-vulpea-dispatch-json "e30=")))))
     (should (eq :json-false (alist-get 'ok response))))))
