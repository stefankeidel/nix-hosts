;;; bridge.el --- Structured PARA operations for Pi -*- lexical-binding: t; -*-

(require 'cl-lib)
(require 'json)
(require 'org)
(require 'org-id)
(require 'org-archive)
(require 'subr-x)

(defun pi-vulpea--get (request key &optional default)
  (alist-get key request default nil #'equal))

(defun pi-vulpea--root ()
  (let ((root (file-name-as-directory (file-truename org-directory))))
    (unless (and (file-directory-p root)
                 (seq-some (lambda (dir) (equal root (file-name-as-directory
                                                      (file-truename dir))))
                           vulpea-db-sync-directories))
      (error "org-directory must be an existing, synced Vulpea vault"))
    root))

(defun pi-vulpea--path (path)
  (let ((real (file-truename path)))
    (unless (and (not (file-remote-p path))
                 (file-in-directory-p real (pi-vulpea--root))
                 (string-suffix-p ".org" real))
      (error "Note is outside the active Org vault"))
    real))

(defun pi-vulpea--note (id)
  (unless (and (stringp id) (not (string-empty-p id)))
    (error "An exact note ID is required"))
  (let ((note (vulpea-db-get-by-id id)))
    (unless note (error "No active indexed note with ID %s" id))
    (pi-vulpea--path (vulpea-note-path note))
    note))

(defun pi-vulpea--buffer (path &optional writing revision)
  (let* ((enable-local-variables nil)
         (enable-local-eval nil)
         (canonical (pi-vulpea--path path))
         ;; Reuse first: find-file-noselect can otherwise ask to reload a changed file.
         (buffer (or (find-buffer-visiting canonical) (find-file-noselect canonical))))
    (with-current-buffer buffer
      (unless (derived-mode-p 'org-mode) (error "Target is not an Org buffer"))
      (unless (verify-visited-file-modtime buffer)
        (error "File changed on disk; revert or reconcile it in Emacs first"))
      (when writing
        (when (or buffer-read-only (buffer-modified-p))
          (error "Target has unsaved edits or is read-only; save it in Emacs first"))
        (unless (and (stringp revision) (equal revision (pi-vulpea--revision)))
          (error "File revision changed; read the target again before writing"))))
    buffer))

(defun pi-vulpea--revision ()
  (save-restriction
    (widen)
    (secure-hash 'sha256 (current-buffer))))

(defun pi-vulpea--goto (note)
  (goto-char (point-min))
  (if (= 0 (vulpea-note-level note))
      (unless (equal (org-entry-get (point) "ID") (vulpea-note-id note))
        (error "File ID no longer matches the index"))
    (let ((position (org-find-property "ID" (vulpea-note-id note))))
      (unless position (error "Heading ID no longer exists; refresh the index"))
      (goto-char position)
      (org-back-to-heading t))))

(defun pi-vulpea--project-p (note)
  "Do not mistake inherited project tags on tasks for project roots."
  (and (vulpea-para-project-p note)
       (with-current-buffer (pi-vulpea--buffer (vulpea-note-path note))
         (save-excursion
           (save-restriction
             (widen)
             (pi-vulpea--goto note)
             (member vulpea-para-project-tag (org-get-tags nil t)))))))

(defun pi-vulpea--summary (note)
  `((id . ,(vulpea-note-id note))
    (title . ,(vulpea-note-title note))
    (file . ,(file-relative-name (vulpea-note-path note) (pi-vulpea--root)))
    (level . ,(vulpea-note-level note))
    (tags . ,(vconcat (vulpea-note-tags note)))
    (todo . ,(vulpea-note-todo note))
    (aliases . ,(vconcat (vulpea-note-aliases note)))
    (buckets . ,(vconcat (mapcar #'symbol-name
                                 (if (pi-vulpea--project-p note)
                                     (vulpea-para-note-buckets note)
                                   (remq 'project (vulpea-para-note-buckets note))))))))

(defun pi-vulpea--number (request key default maximum)
  (let ((value (pi-vulpea--get request key default)))
    (unless (and (integerp value) (>= value 0) (<= value maximum))
      (error "Invalid %s" key))
    value))

(defun pi-vulpea--list (request)
  (let* ((kind (pi-vulpea--get request "kind" "all"))
         (query (downcase (pi-vulpea--get request "query" "")))
         (parent-id (pi-vulpea--get request "parentId"))
         (parent (when parent-id (pi-vulpea--note parent-id)))
         (offset (pi-vulpea--number request "offset" 0 1000000))
         (limit (max 1 (pi-vulpea--number request "limit" 25 100)))
         (notes (pcase kind
                  ("area" (vulpea-para-areas))
                  ("project" (vulpea-para-projects))
                  ("resource" (vulpea-para-resources))
                  ("person" (vulpea-db-query-by-tags-some (list vulpea-para-people-tag)))
                  ((or "all" "task") (vulpea-db-query))
                  (_ (error "Unknown note kind"))))
         matches)
    (dolist (note notes)
      (when (and (ignore-errors (pi-vulpea--path (vulpea-note-path note)))
                 (not (vulpea-para-archived-p note))
                 (or (not (equal kind "project")) (pi-vulpea--project-p note))
                 (or (not (equal kind "person")) (= 0 (vulpea-note-level note)))
                 (or (not (equal kind "task")) (vulpea-note-todo note))
                 (or (not parent) (equal (vulpea-note-path parent) (vulpea-note-path note)))
                 (string-match-p (regexp-quote query)
                                 (downcase (string-join
                                            (cons (vulpea-note-title note)
                                                  (vulpea-note-aliases note)) " "))))
        (push note matches)))
    (setq matches (sort matches (lambda (a b)
                                  (string< (concat (vulpea-note-title a) (vulpea-note-id a))
                                           (concat (vulpea-note-title b) (vulpea-note-id b))))))
    (let* ((total (length matches))
           (end (min total (+ offset limit))))
      `((items . ,(vconcat (mapcar #'pi-vulpea--summary
                                   (seq-subseq matches (min offset total) end))))
        (total . ,total)
        (nextOffset . ,(when (< end total) end))))))

(defun pi-vulpea--read (request)
  (let* ((note (pi-vulpea--note (pi-vulpea--get request "id")))
         (offset (pi-vulpea--number request "offset" 0 10000000))
         (limit (max 1 (pi-vulpea--number request "limit" 12000 20000))))
    (with-current-buffer (pi-vulpea--buffer (vulpea-note-path note))
      (save-excursion
        (save-restriction
          (widen)
          (pi-vulpea--goto note)
          (let* ((start (point))
                 (end (if (= 0 (vulpea-note-level note)) (point-max)
                        (save-excursion (org-end-of-subtree t t) (point))))
                 (size (- end start))
                 (until (min size (+ offset limit))))
            `((note . ,(pi-vulpea--summary note))
              (revision . ,(pi-vulpea--revision))
              (unsaved . ,(if (buffer-modified-p) t :json-false))
              (content . ,(buffer-substring-no-properties
                           (+ start (min offset size)) (+ start until)))
              (totalChars . ,size)
              (nextOffset . ,(when (< until size) until)))))))))

(defun pi-vulpea--search (request)
  (let* ((query (pi-vulpea--get request "query"))
         (offset (pi-vulpea--number request "offset" 0 1000000))
         (limit (max 1 (pi-vulpea--number request "limit" 25 100)))
         (seen 0) hits more)
    (unless (and (stringp query) (> (length query) 0) (<= (length query) 300))
      (error "A literal query of 1-300 characters is required"))
    (catch 'full
      (dolist (path (sort (directory-files-recursively (pi-vulpea--root) "\\.org\\'") #'string<))
        (when (ignore-errors (pi-vulpea--path path))
          (with-current-buffer (pi-vulpea--buffer path)
            (save-excursion
              (save-restriction
                (widen)
                (goto-char (point-min))
                (let ((case-fold-search t))
                  (while (search-forward query nil t)
                    (when (>= seen offset)
                      (when (>= (length hits) limit)
                        (setq more t)
                        (throw 'full nil))
                      (let ((line (line-number-at-pos))
                            (snippet (buffer-substring-no-properties
                                      (max (line-beginning-position) (- (point) 150))
                                      (min (line-end-position) (+ (point) 150)))))
                        (push `((file . ,(file-relative-name path (pi-vulpea--root)))
                                (line . ,line) (snippet . ,(truncate-string-to-width snippet 300))
                                (unsaved . ,(if (buffer-modified-p) t :json-false))) hits)))
                    (setq seen (1+ seen))
                    (forward-line 1)))))))))
    `((items . ,(vconcat (nreverse hits)))
      (nextOffset . ,(when more (+ offset (length hits)))))))

(defun pi-vulpea--body-start (level)
  (if (> level 0)
      (org-end-of-meta-data t)
    (goto-char (point-min))
    (when (looking-at-p ":PROPERTIES:")
      (unless (re-search-forward "^:END:[ \t]*$" nil t) (error "Unterminated file properties"))
      (forward-line 1))
    (while (and (< (point) (point-max)) (looking-at-p "[ \t]*$\\|#\\+"))
      (forward-line 1)))
  (point))

(defun pi-vulpea--title (title)
  (unless (and (stringp title) (> (length title) 0) (<= (length title) 300)
               (not (string-match-p "[\n\r\t]" title))
               (not (string-match-p "\\`[ *#:]\\|[ \t]:[^ \t]+:\\'" title)))
    (error "Title must be a plain, non-empty single line (max 300 characters)"))
  title)

(defun pi-vulpea--tags (tags)
  (unless (and (listp tags)
               (seq-every-p (lambda (tag)
                              (and (stringp tag)
                                   (string-match-p "\\`[[:alnum:]_@#%]+\\'" tag))) tags))
    (error "Invalid Org tags"))
  (when (seq-intersection tags (list vulpea-para-agenda-tag "ARCHIVE"))
    (error "Agenda and archive tags are managed by the workflow"))
  tags)

(defun pi-vulpea--body (text level)
  (unless (and (stringp text) (<= (length text) 50000))
    (error "Body must be a string of at most 50000 characters"))
  (with-temp-buffer
    (insert text)
    (goto-char (point-min))
    (while (re-search-forward "^\\(\\*+\\) " nil t)
      (when (<= (length (match-string 1)) level)
        (error "Body headings must be deeper than their target (level %s)" level)))
    (goto-char (point-min))
    (when (re-search-forward "^#\\+\\(?:title\\|filetags\\|todo\\|seq_todo\\|property\\):\\|Local Variables:" nil t)
      (error "Use structured fields, not document settings or local variables, in body text")))
  text)

(defun pi-vulpea--save ()
  (save-buffer)
  ;; Autosync is asynchronous; make the next tool call see this write immediately.
  (vulpea-db-update-file buffer-file-name))

(defun pi-vulpea--container (title)
  "Return an indexed top-level container named TITLE in the current buffer."
  (goto-char (point-min))
  (if (re-search-forward (concat "^\\* " (regexp-quote title)
                                 "\\(?:[ \t]+:[^ \t\n]+:\\)?[ \t]*$") nil t)
      (org-back-to-heading t)
    (goto-char (point-max))
    (unless (bolp) (insert "\n"))
    (insert "* " title "\n")
    (forward-line -1))
  (org-id-get-create))

(defun pi-vulpea--insert-child (parent title body tags todo)
  "Insert a literal child without expanding capture templates or evaluating Elisp."
  (pi-vulpea--goto parent)
  (let ((level (1+ (vulpea-note-level parent))))
    (pi-vulpea--body body level)
    (if (= 0 (vulpea-note-level parent))
        (goto-char (point-max))
      (org-end-of-subtree t t))
    (unless (bolp) (insert "\n"))
    (insert (make-string level ?*) " " title "\n")
    (forward-line -1)
    (when tags (org-set-tags tags))
    (let ((org-inhibit-logging t)) (when todo (org-todo todo)))
    (let ((id (org-id-get-create)))
      (org-end-of-meta-data t)
      (unless (bolp) (insert "\n"))
      (insert body "\n")
      id)))

(defun pi-vulpea--people-tags (ids)
  (mapcar (lambda (id)
            (let ((person (pi-vulpea--note id)))
              (unless (member vulpea-para-people-tag (vulpea-note-tags person))
                (error "Person ID does not identify a people note"))
              (car (pi-vulpea--tags
                    (list (vulpea-para-agenda--title-to-tag (vulpea-note-title person)))))))
          ids))

(defun pi-vulpea--create (request)
  (let* ((kind (pi-vulpea--get request "kind"))
         (title (pi-vulpea--title (pi-vulpea--get request "title")))
         (body (pi-vulpea--get request "body" ""))
         (tags (delete-dups (append (pi-vulpea--tags (pi-vulpea--get request "tags"))
                                    (pi-vulpea--people-tags (pi-vulpea--get request "peopleIds")))))
         (parent-id (pi-vulpea--get request "parentId"))
         (parent (when parent-id (pi-vulpea--note parent-id)))
         (revision (pi-vulpea--get request "revision"))
         id path)
    (when (seq-intersection tags (list vulpea-para-area-tag vulpea-para-project-tag vulpea-para-people-tag))
      (error "Use the creation kind, not manual PARA classification tags"))
    (when (seq-some (lambda (note) (equal title (vulpea-note-title note)))
                    (if parent (vulpea-db-query-by-file-paths (list (vulpea-note-path parent)))
                      (vulpea-db-query-by-level 0)))
      (error "A note with this exact title already exists; inspect it before creating another"))
    (pcase kind
      ((or "resource" "person")
       (when parent (error "Resources and people are file-level notes; use heading for reference inside an area"))
       (when (member vulpea-para-area-tag tags) (error "New areas require a deliberate user decision outside this tool"))
       (pi-vulpea--body body 0)
       (setq id (org-id-new)
             path (pi-vulpea--path (expand-file-name (concat kind "/" id ".org") (pi-vulpea--root))))
       (when (file-exists-p path) (error "Refusing to overwrite a note"))
       (make-directory (file-name-directory path) t)
       (with-current-buffer (find-file-noselect path)
         (org-mode)
         (atomic-change-group
           (insert ":PROPERTIES:\n:ID: " id "\n:END:\n#+title: " title "\n")
           (goto-char (point-min))
           (apply #'vulpea-buffer-tags-set
                  (delete-dups (append tags (when (equal kind "person") (list vulpea-para-people-tag)))))
           (goto-char (point-max))
           (insert "\n" body "\n")
           (when (equal kind "person")
             (pi-vulpea--container vulpea-para-capture-meeting-headline)
             (pi-vulpea--container "Tasks")))
         (org-id-add-location id path)
         (pi-vulpea--save)))
      ((or "project" "task" "heading" "meeting")
       (unless parent (error "Existing parentId and its revision are required"))
       (when (and (equal kind "project") (not (vulpea-para-area-p parent)))
         (error "Projects must be created under an existing area"))
       (when (and (equal kind "meeting")
                  (or (/= 0 (vulpea-note-level parent))
                      (not (member vulpea-para-people-tag (vulpea-note-tags parent)))))
         (error "Meetings must be created under a file-level people note"))
       (when (member vulpea-para-project-tag tags)
         (error "Use kind project rather than setting its tag manually"))
       (setq path (vulpea-note-path parent))
       (with-current-buffer (pi-vulpea--buffer path t revision)
         (save-excursion
           (save-restriction
             (widen)
             (atomic-change-group
               (when (or (equal kind "project") (equal kind "meeting")
                         (and (equal kind "task") (= 0 (vulpea-note-level parent))))
                 (let ((container-id (pi-vulpea--container
                                      (if (equal kind "meeting") vulpea-para-capture-meeting-headline "Tasks"))))
                   (setq parent (make-vulpea-note :id container-id :path path :level 1))))
               (setq id (pi-vulpea--insert-child
                         parent title body
                         (append tags (pcase kind ("project" (list vulpea-para-project-tag))
                                             ("meeting" '("MEETING"))))
                         (when (member kind '("project" "task")) "TODO")))
               (when (equal kind "project")
                 (goto-char (org-find-property "ID" id))
                 (org-set-property "CATEGORY"
                                   (vulpea-para-category
                                    (vulpea-note-title (pi-vulpea--note parent-id)) title))))
             (pi-vulpea--save)))))
      (_ (error "Unsupported creation kind (area creation is intentionally not exposed)")))
    (append `((created . t)) (pi-vulpea--read `(("id" . ,id) ("limit" . 4000))))))

(defun pi-vulpea--update (request)
  (let* ((case-fold-search nil)
         (note (pi-vulpea--note (pi-vulpea--get request "id")))
         (action (pi-vulpea--get request "action"))
         (text (pi-vulpea--get request "text" ""))
         (level (vulpea-note-level note))
         (result-id (vulpea-note-id note)))
    (with-current-buffer (pi-vulpea--buffer (vulpea-note-path note) t (pi-vulpea--get request "revision"))
      (save-excursion
        (save-restriction
          (widen)
          (pi-vulpea--goto note)
          (atomic-change-group
            (pcase action
              ("append"
               (pi-vulpea--body text level)
               (if (= level 0)
                   (progn (goto-char (point-min))
                          (if (re-search-forward org-heading-regexp nil t)
                              (beginning-of-line) (goto-char (point-max))))
                 (org-end-of-meta-data t)
                 (if (re-search-forward org-heading-regexp nil t)
                     (beginning-of-line) (goto-char (point-max))))
               (unless (bolp) (insert "\n"))
               (insert "\n" text "\n"))
              ("replace"
               ;; Replace only a unique literal fragment of the body, never IDs or metadata.
               (let* ((old (pi-vulpea--get request "oldText"))
                      (start (pi-vulpea--body-start level))
                      (end (save-excursion
                             (if (re-search-forward org-heading-regexp nil t)
                                 (line-beginning-position) (point-max)))))
                 (pi-vulpea--body text level)
                 (unless (and (stringp old) (not (string-empty-p old))
                              (not (string-match-p "^\\*+ \\|^#\\+\\|^:ID:" old)))
                   (error "oldText must be a non-empty body fragment, not metadata or headings"))
                 (goto-char start)
                 (unless (search-forward old end t) (error "oldText not found in the node's own body"))
                 (let ((begin (- (point) (length old))))
                   (when (search-forward old end t) (error "oldText is not unique"))
                   (goto-char begin)
                   (delete-region begin (+ begin (length old)))
                   (insert text))))
              ("todo"
               (when (= level 0) (error "TODO states belong to headings"))
               (unless (member text '("TODO" "DONE" "CANCELLED")) (error "Unsupported TODO state"))
               (let ((org-inhibit-logging t)) (org-todo text)))
              ("tags"
               (let* ((add (pi-vulpea--tags (pi-vulpea--get request "addTags")))
                      (remove (pi-vulpea--tags (pi-vulpea--get request "removeTags")))
                      (protected (list vulpea-para-area-tag vulpea-para-project-tag vulpea-para-people-tag)))
                 (when (seq-intersection (append add remove) protected)
                   (error "Area, project, and people classification cannot be changed by a tag edit"))
                 (let ((tags (delete-dups (append (seq-difference (if (= level 0)
                                                                      (vulpea-buffer-tags-get t)
                                                                    (org-get-tags nil t)) remove)
                                                  add (pi-vulpea--people-tags (pi-vulpea--get request "peopleIds"))))))
                   (if (= level 0) (apply #'vulpea-buffer-tags-set tags) (org-set-tags tags)))))
              ("index"
               (let* ((outline (pi-vulpea--get request "outline"))
                      (base (if (= level 0) nil (org-get-outline-path t t)))
                      (start (point))
                      (end (if (= level 0) (point-max)
                             (save-excursion (org-end-of-subtree t t) (point))))
                      matches)
                 (unless (and (listp outline) outline
                              (seq-every-p (lambda (part) (and (stringp part) (not (string-empty-p part)))) outline))
                   (error "index requires a non-empty relative heading outline"))
                 (org-map-entries
                  (lambda ()
                    (when (and (>= (point) start) (< (point) end)
                               (equal (append base outline) (org-get-outline-path t t)))
                      (push (point) matches))) nil 'file)
                 (unless (= 1 (length matches))
                   (error "Heading outline must identify exactly one existing heading"))
                 (goto-char (car matches))
                 (when (or (org-in-archived-heading-p) (org-entry-get nil "ARCHIVE_TIME" 'inherit))
                   (error "Archived headings are not added to the active index"))
                 (setq result-id (org-id-get-create))))
              ("archive"
               (when (= level 0) (error "Whole-file archiving is intentionally not exposed"))
               (save-excursion
                 (org-map-entries (lambda () (when (member (org-get-todo-state) org-not-done-keywords)
                                               (error "Complete or cancel open work before archiving")))
                                  nil 'tree))
               (let ((marker (point-marker))
                     (org-archive-location "::* Archive"))
                 (vulpea-para--ensure-archive-heading)
                 (goto-char marker)
                 (let ((kill-ring nil)
                       (kill-ring-yank-pointer nil)
                       (interprogram-cut-function nil))
                   (org-archive-subtree))
                 (set-marker marker nil)))
              (_ (error "Unsupported update action"))))
          (pi-vulpea--save))))
    (if (equal action "archive")
        `((archived . t) (id . ,(vulpea-note-id note))
          (file . ,(file-relative-name (vulpea-note-path note) (pi-vulpea--root)))
          (destination . "* Archive :ARCHIVE:") (search . "Archive is retained in the Org file, excluded from active index"))
      (pi-vulpea--read `(("id" . ,result-id) ("limit" . 4000))))))

(defun pi-vulpea-dispatch (request)
  "Execute a structured REQUEST in the running Emacs, without arbitrary eval."
  (require 'vulpea)
  (require 'vulpea-db-extract)
  (require 'vulpea-para)
  (pi-vulpea--root)
  (pcase (pi-vulpea--get request "operation")
    ("status" `((vault . ,(pi-vulpea--root))
                (database . ,vulpea-db-location)
                (headingIndexing . ,(if vulpea-db-index-heading-level t :json-false))
                (agendaStartDay . ,org-agenda-start-day)
                (peopleTag . ,vulpea-para-people-tag)
                (resourceModel . "Active file-level reference notes; no resource tag required")))
    ("list" (pi-vulpea--list request))
    ("search" (pi-vulpea--search request))
    ("read" (pi-vulpea--read request))
    ("create" (pi-vulpea--create request))
    ("update" (pi-vulpea--update request))
    (_ (error "Unknown operation"))))

(defun pi-vulpea-dispatch-json (encoded)
  "Decode a base64 JSON request and return a base64 JSON response."
  (let ((response
         (condition-case err
             (let* ((json-object-type 'alist)
                    (json-array-type 'list)
                    (json-key-type 'string)
                    (request (json-read-from-string
                              (decode-coding-string (base64-decode-string encoded) 'utf-8))))
               `((ok . t) (data . ,(pi-vulpea-dispatch request))))
           (error `((ok . :json-false) (error . ,(error-message-string err)))))))
    (base64-encode-string (encode-coding-string (json-encode response) 'utf-8) t)))

(provide 'pi-vulpea-bridge)
;;; bridge.el ends here
